{
  "config_path": "./config",
  "output_path": "./output/kinms_mock_unlensed_noisy_cube/",
  "data_directory": "./data/kinms_mock_unlensed_noisy",
  "uids": ["kinms_mock_unlensed"],
  "width": "30kms",
  "data_patterns": {
    "frequencies": "frequencies_{uid}_width_{width}_contsub.fits",
    "uv_wavelengths": "uv_wavelengths_{uid}_width_{width}_contsub.fits",
    "visibilities": "visibilities_{uid}_width_{width}_contsub.fits",
    "sigma": "sigma_statwt_{uid}_width_{width}_contsub.fits"
  },
  "mode": "cube",
  "fov": 5.0,
  "source_pixel_scale": "nyquist",
  "mask_n_pixels": 40,
  "mask_pad_pixels": 20,
  "transformer": "nufft",
  "mesh_type": "rectangular_uniform",
  "mesh_shape": [40, 40],
  "regularization": {
    "type": "constant",
    "prior_type": "fixed",
    "value": 1.0
  },
  "cube": {
    "regularization": "from_mfs"
  },
  "search": {
    "path_prefix": "kinms_mock_unlensed_noisy_cube",
    "name": "cube",
    "optimizer": "LBFGS",
    "maxiter": 200,
    "figure_of_merit": "log_likelihood_with_regularization",
    "number_of_cores": 1
  },
  "use_positive_only_solver": true,
  "use_edge_zeroed_pixels": true,
  "use_border_relocator": false,
  "use_jax": true
}
