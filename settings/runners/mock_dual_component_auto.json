{
  "config_path": "./config",
  "output_path": "./output/mock_dual_component_auto/",
  "data_directory": "./data/mock_dual_component",
  "uids": ["mock_dual"],
  "width": "mfs",
  "data_patterns": {
    "frequencies": "frequencies_{uid}_width_{width}_contsub.fits",
    "uv_wavelengths": "uv_wavelengths_{uid}_width_{width}_contsub.fits",
    "visibilities": "visibilities_{uid}_width_{width}_contsub.fits",
    "sigma": "sigma_statwt_{uid}_width_{width}_contsub.fits"
  },
  "mode": "mfs",
  "reconstructor": "auto",
  "sky_auto": {
    "snr_threshold": 100.0
  },
  "fov": 2.5,
  "source_pixel_scale": "nyquist",
  "mesh_type": "rectangular_uniform",
  "mesh_shape": [40, 40],
  "mask_n_pixels": 64,
  "mask_pad_pixels": 28,
  "transformer": "nufft",
  "log_sky": {
    "i0": "auto",
    "smooth": "auto",
    "smooth_init": 10000.0,
    "smooth_bounds": [10.0, 1.0e8],
    "maxiter": 3000,
    "maxiter_trial": 500,
    "pixel_scale": "mask",
    "edge_frac": 0.1,
    "edge_prior_ratio": 100.0
  },
  "linear_sky": {
    "smooth": "auto",
    "smooth_init": 1000000.0,
    "smooth_bounds": [100.0, 1.0e10],
    "maxiter": 3000,
    "maxiter_trial": 500,
    "pixel_scale": "mask",
    "edge_frac": 0.1,
    "edge_prior_ratio": 100.0
  },
  "regularization": {
    "type": "constant",
    "prior_type": "fixed",
    "value": 100.0
  },
  "search": {
    "path_prefix": "mock_dual_component_auto",
    "name": "auto",
    "optimizer": "LBFGS",
    "maxiter": 100,
    "figure_of_merit": "log_likelihood_with_regularization",
    "number_of_cores": 1
  },
  "use_positive_only_solver": true,
  "use_edge_zeroed_pixels": true,
  "use_border_relocator": false,
  "use_jax": true
}
