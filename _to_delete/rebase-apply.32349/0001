+        assert a.flux_error == pytest.approx(b.flux_error, rel=1e-3)
+    assert st.regularization_factor == pytest.approx(mem.regularization_factor, rel=1e-3)
+    assert st.chi_squared == pytest.approx(mem.chi_squared, rel=1e-5)
