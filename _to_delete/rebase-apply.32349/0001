+        self._dirty = np.asarray(terms.dirty_fine, dtype=float)     # centred
+        self.k0 = (self._kernel.shape[0] // 2, self._kernel.shape[1] // 2)
+        self.d0 = (self._dirty.shape[0] // 2, self._dirty.shape[1] // 2)
+        self._coeffs: OrderedDict = OrderedDict()
